# 独立 Agent 进程，仅访问专用状态目录和最小凭据。
[Unit]
Description=AntifieldComplexx DSH mcbot-agent
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target
StartLimitIntervalSec=90
StartLimitBurst=5

[Service]
Type=simple
User=antifield-dsh-agent
Group=antifield-dsh-agent
WorkingDirectory=/var/lib/antifield-dsh-mcbot-agent/workspace
StateDirectory=antifield-dsh-mcbot-agent
StateDirectoryMode=0700
RuntimeDirectory=antifield-dsh-mcbot-agent-status
RuntimeDirectoryMode=0755
Environment=HOME=/var/lib/antifield-dsh-mcbot-agent
Environment=DSH_HOME=/var/lib/antifield-dsh-mcbot-agent/profile
Environment=DSH_STATUS_PATH=/run/antifield-dsh-mcbot-agent-status/status.json
LoadCredential=deepseek-key:/etc/antifieldcloud/dsh/mcbot-agent-deepseek-key
Environment=DSH_AGENT_SOCKET=/run/antifield-dsh-agent-link/agent.sock
Environment=DSH_MCBOT_TOOL_SOCKET=/run/antifield-dsh-tools-link/tools.sock
ExecStartPre=/usr/bin/rm -f /run/antifield-dsh-agent-link/agent.sock
ReadWritePaths=/run/antifield-dsh-agent-link
SupplementaryGroups=dsh-mcbot-link
ExecStart=/usr/local/bin/node /opt/antifield-dsh/current/mcbot-agent.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
InaccessiblePaths=-/var/lib/antifieldcloud -/var/lib/mcbot -/var/lib/opencode -/etc/mcbot -/etc/antifieldcloud
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=896M

[Install]
WantedBy=multi-user.target
